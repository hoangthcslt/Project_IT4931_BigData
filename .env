# ============================================================================
# NYC Transit Real-Time Passenger Flow & Overcrowding Analytics System (IT4931)
# Environment Configuration (.env)
# ============================================================================

# --- Apache Kafka & Zookeeper ---
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=mta-turnstile-stream

# --- Hadoop HDFS ---
HDFS_NAMENODE_HTTP_PORT=9870
HDFS_NAMENODE_RPC_PORT=9000
HDFS_DATANODE_PORT=9864
HDFS_DEFAULT_FS=hdfs://namenode:9000
HDFS_PARQUET_PATH=hdfs://namenode:9000/mta/cleaned_turnstile

# --- Apache Spark Cluster ---
SPARK_MASTER_WEBUI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_WORKER_WEBUI_PORT=8081
SPARK_MASTER_URL=spark://localhost:7077
SPARK_WORKER_MEMORY=4G
SPARK_WORKER_CORES=2

# --- Elasticsearch & Kibana (Serving & Presentation Layer) ---
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_HOST=http://localhost:9200
KIBANA_PORT=5601
ES_INDEX_CLUSTERS=mta-station-clusters
ES_INDEX_BASELINE=mta-turnstile-baseline
ES_INDEX_REALTIME_FLOW=mta-realtime-flow
ES_INDEX_ALERTS=mta-congestion-alerts

# --- Data Paths & Application Parameters ---
TURNSTILE_INPUT_GLOB=data/archive/TurnstileData/turnstile_*.txt
STATION_LOCATIONS_CSV=data/archive/MTA_StationLocations.csv
PERFORMANCE_AGENCIES_CSV=data/archive/NYC_TransitPerformance/MTA_Performance_Agencies.csv
LOCAL_PARQUET_OUTPUT=data/processed/turnstile_parquet
BASELINE_JSON_OUTPUT=data/processed/station_baseline.json
CLUSTERS_JSON_OUTPUT=data/processed/station_clusters.json
CORRELATION_JSON_OUTPUT=data/processed/correlation_results.json
REALTIME_ALERTS_JSON_OUTPUT=data/processed/realtime_alerts.json

# --- Streaming & Anomaly Detection Tuning ---
PRODUCER_MODE=interpolate
PRODUCER_TARGET_RATE=3000
SLIDING_WINDOW_DURATION=15 minutes
SLIDING_WINDOW_SLIDE=1 minute
CRITICAL_Z_SCORE_THRESHOLD=3.0
KMEANS_CLUSTERS_K=3
