{
  "mta-station-clusters": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "station_id": {
          "type": "keyword"
        },
        "stop_name": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword"
            }
          }
        },
        "borough": {
          "type": "keyword"
        },
        "daytime_routes": {
          "type": "keyword"
        },
        "latitude": {
          "type": "double"
        },
        "longitude": {
          "type": "double"
        },
        "location": {
          "type": "geo_point"
        },
        "cluster_id": {
          "type": "integer"
        },
        "archetype": {
          "type": "keyword"
        },
        "estimated_daily_flow": {
          "type": "double"
        },
        "silhouette_score": {
          "type": "double"
        }
      }
    }
  },
